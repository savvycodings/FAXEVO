#!/usr/bin/env bash
# Bring up the local stack the app expects: API :3050, Unsloth :8888, ComfyUI :8188,
# EN voice Studio :8889, ES voice Studio :8890, then one ngrok agent with a separate hostname
# for each. Railway's API reaches chat/voice through those hostnames
# (XEVO_LLM_BASE_URL, XEVO_TTS_BASE_URL, XEVO_TTS_ES_BASE_URL).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LOG_DIR="$ROOT/Workflows/logs"
NGROK_YML="$ROOT/Workflows/ngrok/ngrok.local.yml"
NGROK_USER_YML="${HOME}/.config/ngrok/ngrok.yml"
COMFY_DIR="/home/shini/ComfyUI"
UNSLOTH_LAUNCH="${HOME}/.local/share/unsloth/launch-studio.sh"
export ANDROID_HOME="${ANDROID_HOME:-/home/shini/Android/Sdk}"
ADB="$ANDROID_HOME/platform-tools/adb"
EMULATOR_BIN="$ANDROID_HOME/emulator/emulator"

API_URL="https://xevo-api-kyle.ngrok-free.dev"
LLM_URL="https://xevo-sloth-kyle.ngrok.app"
COMFY_URL="https://xevo-comfy-kyle.ngrok.dev"
VOICE_URL="https://xevo-voice-kyle.ngrok.app"
VOICE_ES_URL="https://xevo-voice-es-kyle.ngrok.app"

mkdir -p "$LOG_DIR"

listening() {
  local port="$1"
  ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE "[.:]${port}$"
}

wait_port() {
  local port="$1"
  local label="$2"
  local i
  for i in $(seq 1 90); do
    if listening "$port"; then
      echo "$label is up on :$port"
      return 0
    fi
    sleep 1
  done
  echo "$label did not listen on :$port within 90s. See $LOG_DIR" >&2
  return 1
}

start_comfy() {
  if listening 8188; then
    echo "ComfyUI already listening on :8188"
    return 0
  fi
  echo "Starting ComfyUI"
  setsid "$COMFY_DIR/.venv/bin/python" "$COMFY_DIR/main.py" --listen 127.0.0.1 --port 8188 \
    </dev/null >>"$LOG_DIR/comfy.log" 2>&1 &
  echo $! >"$LOG_DIR/comfy.pid"
  wait_port 8188 "ComfyUI"
}

start_unsloth() {
  if listening 8888; then
    echo "Unsloth already listening on :8888"
    return 0
  fi
  echo "Starting Unsloth Studio"
  setsid "$UNSLOTH_LAUNCH" </dev/null >>"$LOG_DIR/unsloth.log" 2>&1 &
  echo $! >"$LOG_DIR/unsloth.pid"
  wait_port 8888 "Unsloth"
}

# Studio holds one model at a time, so coach voices run in isolated instances and the main
# one keeps the chat/analysis model. EN Ceylia :8889, ES Maria :8890.
VOICE_HOME="${HOME}/.unsloth/studio-voice"
VOICE_ES_HOME="${HOME}/.unsloth/studio-voice-es"
STUDIO_HOME_MAIN="${HOME}/.unsloth/studio"
CHAT_MODEL="unsloth/Qwen3.5-4B-GGUF"
CHAT_VARIANT="UD-Q4_K_XL"
VOICE_MODEL="vinhnx90/VT-Orpheus-3B-TTS-Ceylia-Q4KM-GGUFF"
VOICE_VARIANT="Q4_K_M"
VOICE_ES_MODEL="freddyaboulton/3b-es_it-ft-research_release-Q4_K_M-GGUF"
VOICE_ES_VARIANT="Q4_K_M"

studio_key() {
  grep -E '^XEVO_LLM_API_KEY=' "$ROOT/server/.env" 2>/dev/null | head -n1 | cut -d= -f2- | tr -d '"'
}

# Load <model> into the Studio on <port> unless it is already resident.
# Optional 4th arg: max_seq_length (TTS uses a small window so EN+ES fit beside chat).
# Optional 5th arg: n_parallel (default 1 when max_seq_length is set).
ensure_studio_model() {
  local port="$1" model="$2" variant="$3" max_seq="${4:-}" n_par="${5:-1}" key body
  key="$(studio_key)"
  if [ -z "$max_seq" ] && curl -sf --max-time 5 -H "Authorization: Bearer $key" "http://127.0.0.1:$port/v1/models" \
    | grep -q "\"id\":\"$model\"[^}]*\"loaded\":true"; then
    echo "$model already loaded on :$port"
    return 0
  fi
  # For TTS: skip only when already loaded at the intended small context.
  if [ -n "$max_seq" ] && curl -sf --max-time 5 -H "Authorization: Bearer $key" "http://127.0.0.1:$port/v1/models" \
    | python3 -c "import sys,json; d=json.load(sys.stdin); m=next((x for x in d.get('data',[]) if x.get('id')==sys.argv[1]),None); sys.exit(0 if m and m.get('loaded') and int(m.get('context_length') or 0)==int(sys.argv[2]) else 1)" \
      "$model" "$max_seq" 2>/dev/null; then
    echo "$model already loaded on :$port (ctx=$max_seq)"
    return 0
  fi
  echo "Loading $model on :$port${max_seq:+ (ctx=$max_seq, parallel=$n_par)}"
  if [ -n "$max_seq" ]; then
    body="{\"model_path\":\"$model\",\"gguf_variant\":\"$variant\",\"max_seq_length\":$max_seq,\"n_parallel\":$n_par,\"force_reload\":true}"
  else
    body="{\"model_path\":\"$model\",\"gguf_variant\":\"$variant\"}"
  fi
  curl -sf --max-time 900 -X POST -H "Authorization: Bearer $key" -H "Content-Type: application/json" \
    "http://127.0.0.1:$port/v1/load" \
    -d "$body" >/dev/null \
    || { echo "Could not load $model on :$port" >&2; return 1; }
}

# TTS Orpheus only needs a short prompt window; 4096 keeps EN+ES resident with chat on one GPU.
VOICE_CTX=4096

start_voice_studio_on() {
  local port="$1" home="$2" model="$3" variant="$4" label="$5" log="$6" pidfile="$7"
  if ! listening "$port"; then
    echo "Starting $label"
    mkdir -p "$home"
    # Same venv and login as the main Studio; models come from the shared Hugging Face cache.
    [ -e "$home/unsloth_studio" ] || ln -s "$STUDIO_HOME_MAIN/unsloth_studio" "$home/unsloth_studio"
    [ -d "$home/auth" ] || cp -r "$STUDIO_HOME_MAIN/auth" "$home/auth"
    UNSLOTH_STUDIO_HOME="$home" \
      LLAMA_SERVER_PATH="${HOME}/.unsloth/llama.cpp/build/bin/llama-server" \
      setsid "$STUDIO_HOME_MAIN/unsloth_studio/bin/unsloth" studio -p "$port" --api-only \
      </dev/null >>"$log" 2>&1 &
    echo $! >"$pidfile"
    wait_port "$port" "$label"
  else
    echo "$label already listening on :$port"
  fi
  ensure_studio_model "$port" "$model" "$variant" "$VOICE_CTX" 1
}

start_voice_studio() {
  start_voice_studio_on 8889 "$VOICE_HOME" "$VOICE_MODEL" "$VOICE_VARIANT" \
    "EN Voice Studio" "$LOG_DIR/unsloth-voice.log" "$LOG_DIR/unsloth-voice.pid"
}

start_voice_studio_es() {
  start_voice_studio_on 8890 "$VOICE_ES_HOME" "$VOICE_ES_MODEL" "$VOICE_ES_VARIANT" \
    "ES Voice Studio" "$LOG_DIR/unsloth-voice-es.log" "$LOG_DIR/unsloth-voice-es.pid"
}

start_api() {
  if listening 3050; then
    echo "API already listening on :3050"
    return 0
  fi
  echo "Starting API"
  setsid pnpm dev </dev/null >>"$LOG_DIR/api.log" 2>&1 &
  echo $! >"$LOG_DIR/api.pid"
  wait_port 3050 "API"
}

ngrok_has_all() {
  local body
  body="$(curl -sf --max-time 2 http://127.0.0.1:4040/api/tunnels 2>/dev/null || true)"
  [[ "$body" == *"xevo-api-kyle.ngrok-free.dev"* ]] \
    && [[ "$body" == *"xevo-sloth-kyle.ngrok.app"* ]] \
    && [[ "$body" == *"xevo-comfy-kyle.ngrok.dev"* ]] \
    &&   [[ "$body" == *"xevo-voice-kyle.ngrok.app"* ]]
}

start_ngrok() {
  if ngrok_has_all; then
    echo "ngrok already has xevo-api, unsloth, comfy, and voice (voice-es started if domain exists)"
    return 0
  fi
  if listening 4040; then
    echo "ngrok is up but missing a tunnel; restarting it"
    pkill -x ngrok || true
    sleep 1
  fi
  echo "Starting ngrok tunnels"
  : >"$LOG_DIR/ngrok.log"
  setsid ngrok start \
    --config "$NGROK_USER_YML" \
    --config "$NGROK_YML" \
    xevo-api unsloth comfy voice voice-es \
    --log=stdout \
    </dev/null >>"$LOG_DIR/ngrok.log" 2>&1 &
  echo $! >"$LOG_DIR/ngrok.pid"
  local i
  for i in $(seq 1 30); do
    if ngrok_has_all; then
      echo "ngrok tunnels are up"
      return 0
    fi
    if grep -q "failed to start" "$LOG_DIR/ngrok.log" 2>/dev/null; then
      echo "ngrok failed. See $LOG_DIR/ngrok.log" >&2
      return 1
    fi
    sleep 1
  done
  echo "ngrok did not publish all five hostnames. See $LOG_DIR/ngrok.log" >&2
  return 1
}

emulator_booted() {
  "$ADB" devices 2>/dev/null | grep -q 'emulator-.*device' || return 1
  local boot
  boot="$("$ADB" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')"
  [[ "$boot" == "1" ]]
}

start_emulator() {
  if emulator_booted; then
    echo "Pixel 8 emulator already booted"
    return 0
  fi
  if ! pgrep -f "qemu-system.*expo_pixel8|emulator -avd expo_pixel8" >/dev/null 2>&1; then
    echo "Starting expo_pixel8"
    setsid "$EMULATOR_BIN" -avd expo_pixel8 \
      </dev/null >>"$LOG_DIR/emulator.log" 2>&1 &
    echo $! >"$LOG_DIR/emulator.pid"
  else
    echo "Pixel 8 emulator is already starting"
  fi
  local i
  for i in $(seq 1 180); do
    if emulator_booted; then
      echo "Pixel 8 booted"
      return 0
    fi
    sleep 2
  done
  echo "Emulator did not finish booting. See $LOG_DIR/emulator.log" >&2
  return 1
}

start_expo() {
  if listening 8081; then
    echo "Metro already listening on :8081"
    return 0
  fi
  echo "Building and installing the app on the emulator"
  chmod +x "$ROOT/app/android/gradlew"
  setsid pnpm android </dev/null >>"$LOG_DIR/expo.log" 2>&1 &
  echo $! >"$LOG_DIR/expo.pid"
  local i
  for i in $(seq 1 600); do
    if listening 8081; then
      echo "Metro is up on :8081"
      return 0
    fi
    if grep -qE "BUILD FAILED|CommandError|Failed to install|gradlew EACCES|exited with non-zero code" "$LOG_DIR/expo.log" 2>/dev/null; then
      echo "Expo Android build failed. See $LOG_DIR/expo.log" >&2
      return 1
    fi
    sleep 2
  done
  echo "Metro did not listen on :8081. See $LOG_DIR/expo.log" >&2
  return 1
}

start_comfy
start_unsloth
ensure_studio_model 8888 "$CHAT_MODEL" "$CHAT_VARIANT" || true
start_voice_studio || true
start_voice_studio_es || true
( cd "$ROOT/server" && start_api )
start_ngrok
start_emulator
( cd "$ROOT/app" && start_expo )

echo
echo "API     $API_URL"
echo "Unsloth $LLM_URL/v1"
echo "VoiceEN $VOICE_URL/v1"
echo "VoiceES $VOICE_ES_URL/v1"
echo "Comfy   $COMFY_URL"
echo "Phone   expo_pixel8  (Metro :8081)"
